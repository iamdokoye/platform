# ================================================================
# Promaly Platform — Coolify Environment Template
#
# Copy this file to .env and fill in the values for your deployment.
# Do NOT commit .env — it contains secrets.
# ================================================================

# ── Public URLs (what your browser sees) ──────────────────────
# Base URL of your deployment, no trailing slash.
PUBLIC_URL=https://huly.example.com

# WebSocket URL clients use to reach the transactor (real-time sync).
# If you terminate TLS at a reverse proxy and forward to port 3332:
#   TRANSACTOR_WS_URL=wss://huly.example.com/transactor
# For plain direct access (dev/LAN):
#   TRANSACTOR_WS_URL=ws://huly.example.com:3332
# The trailing ;;cockroach, tells the client which region to use.
TRANSACTOR_WS_URL=wss://huly.example.com:3332;;cockroach,

# WebSocket URL clients use to reach the collaborator (live editing).
COLLABORATOR_WS_URL=wss://huly.example.com:3078

# Optional: override the datalake public URL (file downloads).
# Defaults to PUBLIC_URL if unset.
# DATALAKE_URL=https://huly.example.com

# Optional: override individual service URLs seen by the browser.
# PREVIEW_URL=https://huly.example.com:4040
# LINK_PREVIEW_URL=https://huly.example.com:4041
# HULYLAKE_URL=https://huly.example.com:8096
# PULSE_URL=wss://huly.example.com:8099/ws
# STREAM_URL=https://huly.example.com:1080/recording
# PRINT_URL=https://huly.example.com:4005
# SIGN_URL=https://huly.example.com:4006
# PAYMENT_URL=https://huly.example.com:3040
# GITHUB_URL=https://huly.example.com:3500
# GMAIL_URL=https://huly.example.com:8093
# CALENDAR_URL=https://huly.example.com:8095
# TELEGRAM_URL=https://huly.example.com:8086

# ── Secrets ───────────────────────────────────────────────────
# Shared HMAC secret — change this! Use: openssl rand -hex 32
SERVER_SECRET=changeme-use-a-long-random-string

# ── Object Storage (MinIO) ────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Backup ────────────────────────────────────────────────────
BACKUP_BUCKET_NAME=huly-backups

# ── Admin access ──────────────────────────────────────────────
# Comma-separated list of email addresses that get admin access on signup.
ADMIN_EMAILS=admin@example.com
PLATFORM_ADMIN_EMAILS=

# ── Mail (optional) ───────────────────────────────────────────
# Set to enable email sending (account verification, notifications).
# Example: smtp://user:pass@smtp.example.com:587
MAIL_URL=

# ── Mailbox domains (optional) ────────────────────────────────
MAILBOX_DOMAINS=

# ── Observability (optional) ──────────────────────────────────
# Uncomment jaeger in docker-compose.coolify.yml, then set:
# OTEL_ENDPOINT=http://jaeger:4318/v1/traces

# ── Analytics (optional) ──────────────────────────────────────
# POSTHOG_HOST=https://app.posthog.com
# POSTHOG_API_KEY=

# ── Port overrides (optional) ─────────────────────────────────
# Change these if the defaults conflict with other services.
# FRONT_PORT=8087
# ACCOUNT_PORT=3000
# TRANSACTOR_PORT=3332
# COLLABORATOR_PORT=3078
# STATS_PORT=4900
# DATALAKE_PORT=4030
# FULLTEXT_PORT=4702
# HULYLAKE_PORT=8096
# HULYKVS_PORT=8094
# HULYPULSE_PORT=8099
# REKONI_PORT=4004
# PREVIEW_PORT=4040
# LINK_PREVIEW_PORT=4041
# EXPORT_PORT=4009
# ANALYTICS_PORT=4017
# BACKUP_API_PORT=4039
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# COCKROACH_DB_PORT=26257
