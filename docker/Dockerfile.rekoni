# syntax=docker/dockerfile:1.7
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        git python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @microsoft/rush@5.158.1
WORKDIR /app
COPY . .
RUN git config --global --add safe.directory /app 2>/dev/null || true
RUN rush install
RUN rush bundle -p 20 --to @hcengineering/rekoni-service

FROM node:${NODE_VERSION}-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        libjemalloc2 dumb-init ca-certificates coreutils antiword poppler-utils html2text unrtf \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV LD_PRELOAD=libjemalloc.so.2 \
    MALLOC_CONF=dirty_decay_ms:1000,narenas:2,background_thread:true \
    NODE_ENV=production
RUN npm install --ignore-scripts=false sharp@v0.34.3 pdfjs-dist@v2.12.313 --unsafe-perm
WORKDIR /usr/src/app
COPY --from=builder /app/services/rekoni/bundle/bundle.js ./
EXPOSE 4004
CMD ["node", "./bundle.js"]
